# Name of the SaaS product itself. Tenant-facing screens show the
# tenant's own brand instead — see App\Support\Brand.
PLATFORM_NAME="ValtCRM"

# What a new client is set up with unless the platform owner says otherwise.
# The shipped values are India's; override them for the market you sell in.
# The timezone must be a full IANA name ("Asia/Kolkata"), never an
# abbreviation like IST — PHP does not accept those and dates come out wrong.
PLATFORM_DEFAULT_COUNTRY="India"
PLATFORM_DEFAULT_CURRENCY=INR
PLATFORM_DEFAULT_TIMEZONE=Asia/Kolkata
PLATFORM_DEFAULT_DATE_FORMAT=d/m/Y
PLATFORM_DEFAULT_MEASUREMENT=metric
APP_NAME="${PLATFORM_NAME}"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost

# Shared secret for the scheduler endpoint the Vercel Cron job calls. Without
# it that endpoint refuses every request, so set it on any serverless deploy —
# see DEPLOYMENT.md.
CRON_SECRET=

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

# On Vercel, use LOG_CHANNEL=stderr instead — the filesystem is read-only
# outside /tmp, and stderr is what shows up in Vercel's runtime logs.
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# --------------------------------------------------------------------------
# Database — Supabase PostgreSQL (production)
# --------------------------------------------------------------------------
# Get these from your Supabase project: Project Settings > Database.
# Prefer DB_URL (the "Connection string > URI" value) when available; the
# individual DB_HOST/DB_PORT/... vars below are used as a fallback/override.
# Supabase requires TLS — DB_SSLMODE defaults to "require".
DB_CONNECTION=pgsql
# DB_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres
DB_HOST=db.[PROJECT-REF].supabase.co
DB_PORT=5432
DB_DATABASE=postgres
DB_USERNAME=postgres
DB_PASSWORD=
DB_SSLMODE=require
# DB_CHARSET=utf8
# DB_FOREIGN_KEYS=true

# Never commit real values for the following — set them in your host's
# environment variable settings (e.g. Vercel Project Settings > Environment
# Variables), not in a committed .env file:
# DB_PASSWORD, SUPABASE_SERVICE_ROLE_KEY, AI provider keys, mail credentials.

# Only needed if a feature calls the Supabase REST/Storage API directly
# (most of this app talks to Postgres over DB_URL and does not need these).
# SUPABASE_URL=https://[PROJECT-REF].supabase.co
# SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=s3
QUEUE_CONNECTION=database
# DB_QUEUE_CONNECTION=
# DB_QUEUE_TABLE=jobs
# DB_QUEUE=default
# DB_QUEUE_RETRY_AFTER=90

CACHE_STORE=database
# CACHE_PREFIX=

MAIL_MAILER=smtp
# MAIL_URL=
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=587
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# --------------------------------------------------------------------------
# File storage — do not use the local disk in production (see DEPLOYMENT.md);
# a serverless/container deployment has no persistent filesystem. Use S3 or
# an S3-compatible bucket (Supabase Storage also speaks the S3 protocol).
# --------------------------------------------------------------------------
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_URL=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
